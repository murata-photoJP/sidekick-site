{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sidekick-lab.com" }],
      "destination": "https://www.sidekick-lab.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sidekick-site-tawny.vercel.app" }],
      "destination": "https://www.sidekick-lab.com/$1",
      "permanent": true
    },
    {
      "source": "/card/qr",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|.*[, ])[jJ][aA]($|[-;, ].*)" }],
      "destination": "/sidekick-qr?utm_source=sidekick-qr&utm_medium=qr-card&utm_campaign=secondary-qr",
      "permanent": false
    },
    {
      "source": "/card/qr",
      "destination": "/en/sidekick-qr?utm_source=sidekick-qr&utm_medium=qr-card&utm_campaign=secondary-qr",
      "permanent": false
    },
    {
      "source": "/planner",
      "destination": "/sidekick-planner",
      "statusCode": 301
    },
    {
      "source": "/en/planner",
      "destination": "/en/sidekick-planner",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/validation/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sidekick-qr-app/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [
    { "path": "/api/planner-activity-cleanup", "schedule": "30 18 * * *" }
  ]
}
